{
  "name": "laya-notes",
  "private": true,
  "version": "0.1.0",
  "description": "Markdown notes on your own computer, tagged by the Laya model.",
  "license": "MIT",
  "homepage": "https://itsdula.github.io/laya-notes/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsdula/laya-notes.git"
